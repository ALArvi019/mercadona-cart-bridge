# Copia este fichero a .env y rellénalo. .env NUNCA se sube al repo.

# --- Mercadona ---
# Refresh token de larga duración extraído de la app/navegador (ver docs/obtener-token.md).
# El access token se renueva solo a partir de éste; no hace falta guardar la contraseña.
MERCADONA_REFRESH_TOKEN=
# Código postal / almacén asociado a tu cuenta (determina catálogo y precios).
MERCADONA_POSTAL_CODE=
# Se autodetecta al arrancar si se deja vacío.
MERCADONA_WAREHOUSE=

# --- Google Keep (buzón de voz) ---
# Cuenta Google que recibe la lista de Assistant. Recomendado: cuenta dedicada
# con la lista compartida, no la cuenta principal.
GKEEP_EMAIL=
# Master token obtenido con gpsoauth (ver docs/google-keep.md).
GKEEP_MASTER_TOKEN=
# Nombre exacto de la lista de Keep que Assistant rellena.
GKEEP_LIST_NAME=Lista de la compra
# Segundos entre sondeos de la lista.
GKEEP_POLL_SECONDS=15
# Maximo de elementos que se pasan al carrito en un mismo sondeo. Evita que una
# lista con historico acumulado vuelque todo de golpe; el resto entra despues.
GKEEP_MAX_BATCH=15

# --- Avisos a Home Assistant ---
# Webhook de HA al que avisar cuando la eleccion es dudosa o falla algo.
# No necesita token. Dejalo vacio para no avisar de nada.
HA_WEBHOOK_URL=

# --- Servicio ---
# Token propio para proteger la API/panel dentro de la LAN. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=
APP_PORT=8099
# Si se pone a true, la voz nunca escribe en el carrito: solo simula y registra.
DRY_RUN=false
